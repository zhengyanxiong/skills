{
  "schema_version": 2,
  "notes": [
    "Canonical palette data — single source of truth.",
    "The :root / [data-theme] / .dark blocks in assets/_tokens.generated.css are GENERATED from this file:",
    "    python3 scripts/contrast_check.py assets/tokens.json --emit-css > assets/_tokens.generated.css",
    "Never hand-edit those blocks; edit here, regenerate, re-run the contrast check.",
    "Ratio contract: 60% base + 30% primary + 10% gold accent (gold is decoration, never a text carrier).",
    "btn_from/btn_to exist because a gradient button must pass AA at BOTH ends — reusing primary->gold",
    "does not: white on the original #7FA7C7 primary is only 2.54:1. Gold therefore lives in the rim,",
    "the glow and the hover shine, where no text sits on top of it."
  ],
  "glass": {
    "alpha_supported": 0.3,
    "alpha_fallback": 0.72,
    "alpha_dark_supported": 0.1,
    "alpha_dark_fallback": 0.12,
    "note": "fallback alpha = the opaque fill you paint when backdrop-filter is unsupported. Light mode raises white alpha (lighter card), dark mode keeps it near the blurred value."
  },
